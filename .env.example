# Environment Variables for GOV Website
# Copy this file to .env and fill in your values

# ===================
# EMAIL CONFIGURATION
# ===================

# Gmail SMTP (Recommended for simplicity)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "GOV Website"
# 4. Copy the password below

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Alternative: Other SMTP services
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ===================
# BACKEND CONFIG
# ===================

# Server port (default: 3001)
PORT=3001

# JWT Secret - change this to a random string in production
JWT_SECRET=change-this-to-a-random-string-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===================
# FRONTEND CONFIG
# ===================

# API URL for production (used in production build)
VITE_API_URL=http://localhost:3001/api
