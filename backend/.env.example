# ── Server ──────────────────────────
PORT=3001

# ── MongoDB ─────────────────────────
# Local:  mongodb://localhost:27017/gov-website
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/gov-website
MONGO_URI=mongodb://localhost:27017/gov-website

# ── Email (Gmail) ───────────────────
# Use a Gmail App Password — NOT your real password
# Guide: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_USER=govpccmateroyouth@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ── Frontend origin (for CORS) ──────
CLIENT_ORIGIN=http://localhost:5173
